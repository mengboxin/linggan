# ─── 服务 ────────────────────────────────────────────────────────────────────
PORT=8000

# ─── PostgreSQL（优先读 DATABASE_URL 整串，否则从下面字段拼装）────────────────
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_NAME=layergenius
DB_USER=postgres
DB_PASSWORD=

# ─── Redis（优先读 REDIS_URL 整串，否则从下面字段拼装）──────────────────────
# REDIS_URL=redis://:password@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── 管理员（必填）──────────────────────────────────────────────────────────
ADMIN_PASSWORD=          # 管理后台登录密码，必须修改
ADMIN_EMAIL=             # 接收验证码的邮箱，留空则用 SMTP_USER
SECRET_KEY=              # JWT 签名密钥，必须修改（可用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成）
FOXAPI_BASE_URL=https://foxapi.cn/v1
FOXAPI_CREDENTIAL_ENCRYPTION_KEY=  # 生产环境建议固定设置 Fernet key；修改后旧 Key 将无法解密

# ─── AI 模型 ────────────────────────────────────────────────────────────────
REPLICATE_API_TOKEN=
REMOVE_BG_API_KEY=

# ─── LLM ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
OPENAI_LAYER_IMAGE_MODEL=gpt-image-1.5
OPENAI_LAYER_IMAGE_QUALITY=medium

# ─── 限制 ──────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
MAX_IMAGE_REQUEST_MB=100
MAX_IMAGE_PIXELS=64000000
# Mask refinement uses multiple full-frame NumPy arrays; keep its working set
# below the general image-upload limit and run one request at a time by default.
MASK_REFINE_MAX_PIXELS=8000000
MASK_REFINE_CONCURRENCY=1
MAX_LAYERS=10

# ─── 邮件 SMTP ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 验证码有效期（秒）
OTP_EXPIRE_SECONDS=300

# ─── Worker 并发 ───────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
TASK_STATE_TTL_SECONDS=86400
# Durable terminal effects (credit settlement, release, and user notification)
# are recorded before execution and retried from a dedicated Redis Stream.
TASK_TERMINAL_EFFECT_WORKER_ENABLED=true
TASK_TERMINAL_EFFECT_BATCH_SIZE=32
TASK_TERMINAL_EFFECT_POLL_MS=1000
TASK_TERMINAL_EFFECT_RECLAIM_IDLE_MS=30000
TASK_TERMINAL_EFFECT_LOCK_SECONDS=120
# Production uses a separate worker_main.py process. Local development may set
# this to true only when no standalone worker is running.
START_EMBEDDED_WORKER=false
DEFAULT_TASK_PRIORITY=normal
TASK_FANOUT_CONCURRENCY=1
ICON_ALTERNATIVES_CONCURRENCY=1
PPT_PIPELINE_CONCURRENCY=2
PPT_USER_PIPELINE_CONCURRENCY=1
PPT_CONVERSION_CONCURRENCY=1
PPT_SLIDE_FANOUT_CONCURRENCY=1
PPT_IMAGE_CALL_CONCURRENCY=1
PPT_VISION_CALL_CONCURRENCY=1
IMAGE_GENERATION_CALL_CONCURRENCY=2
IMAGE_TRANSFORM_CONCURRENCY=2
STORAGE_IO_CONCURRENCY=8
# Redis is authoritative for poster/PPT/sci-fig jobs.  This is only a bounded
# process-local fallback for a transient Redis outage; set any value to 0 to disable it.
JOB_STATE_FALLBACK_CACHE_MAX_ENTRIES=12
JOB_STATE_FALLBACK_CACHE_TTL_SECONDS=1800
JOB_STATE_FALLBACK_CACHE_MAX_BYTES=33554432

# Go control plane and the narrow direct-image2 worker. Keep the worker off
# until queue assets, the migration, and the Go service have all been deployed.
GO_CONTROL_PLANE_URL=
GO_CONTROL_PLANE_SHARED_SECRET=
GO_CONTROL_PLANE_TASK_TYPES=generate,layer-edit,touch-replace,touch-recolor,touch-remove,icon-alternatives,segmentation,segmentation-partial
GO_IMAGE2_WORKER_ENABLED=false
GO_IMAGE2_WORKER_MAX_INPUT_BYTES=52428800
GO_IMAGE2_WORKER_MAX_OUTPUT_BYTES=33554432
GO_IMAGE2_WORKER_SHUTDOWN_GRACE_SECONDS=900
GO_IMAGE_HEAVY_WORKER_ENABLED=false
GO_IMAGE_HEAVY_WORKER_MAX_INPUT_BYTES=52428800
GO_IMAGE_HEAVY_WORKER_MAX_OUTPUT_BYTES=33554432
GO_IMAGE_HEAVY_WORKER_SHUTDOWN_GRACE_SECONDS=900
# Used only by the Go container; the Docker Compose default is http://backend:8000.
GO_IMAGE2_BACKEND_URL=http://backend:8000
GO_IMAGE2_WORKER_CONSUMER=
GO_IMAGE_HEAVY_WORKER_CONSUMER=

# ─── PostgreSQL 连接池（每个 API/Worker 进程各自一套）────────────────────────
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=8
DB_POOL_MAX_INACTIVE_SECONDS=300
DB_COMMAND_TIMEOUT_SECONDS=30
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=2
# API 与独立 Worker 启动时不执行迁移；包含迁移的部署需先手动执行：
# python scripts/run_migrate.py

# ─── SAM2 语义分割 ─────────────────────────────────────────────────────────
SAM2_ENDPOINT=https://api.replicate.com/v1/models/meta/sam-2/predictions
SAM2_API_KEY=
SAM2_MAX_IMAGE_SIZE=4096

# ─── GroundingDINO 零样本分类 ──────────────────────────────────────────────
GROUNDING_DINO_ENDPOINT=https://api.replicate.com/v1/models/abrman/grounded-sam/predictions
GROUNDING_DINO_API_KEY=

# ─── Flux Fill Inpainting ──────────────────────────────────────────────────
FLUX_FILL_ENDPOINT=https://api.replicate.com/v1/models/black-forest-labs/flux-fill-pro/predictions
FLUX_FILL_API_KEY=

# ─── LaMa Inpainting ──────────────────────────────────────────────────────
LAMA_ENDPOINT=https://api.replicate.com/v1/models/andreasjansson/lama-cleaner/predictions
LAMA_API_KEY=

# ─── SDXL Inpainting ──────────────────────────────────────────────────────
SDXL_INPAINT_ENDPOINT=https://api.replicate.com/v1/models/stability-ai/sdxl/predictions
SDXL_INPAINT_API_KEY=

# ─── Inpainting 超时（秒）──────────────────────────────────────────────────
INPAINTING_TIMEOUT=30

# ─── PPT 文字擦除 / 背景修补 ──────────────────────────────────────────────
# auto: 优先使用当前图像模型编辑接口生成无字背景；可手动切到 replicate 或 iopaint。
PPT_INPAINT_PROVIDER=auto
PPT_REPLICATE_INPAINT_MODEL=allenhooo/lama
# 仅当 PPT_INPAINT_PROVIDER=iopaint 时使用
PPT_INPAINT_URL=http://127.0.0.1:8080/api/v1/inpaint

# ─── 图片资产存储（推荐生产环境配置 Cloudflare R2）────────────────────────────
# 配置后，文生图/历史图片会把原图、预览图、缩略图存入 R2，数据库只保存 URL/key。
# 留空则保持旧逻辑（数据库 meta 中保留 base64），适合本地开发。
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Optional private S3-compatible mirror. R2 writes enqueue durable mirror jobs;
# backend reads fall back only to completed copies and deletes are retried.
STORAGE_MIRROR_ENABLED=false
STORAGE_MIRROR_PROVIDER=cos
# COS SDK service endpoint, not the bucket-specific public hostname.
STORAGE_MIRROR_ENDPOINT=
STORAGE_MIRROR_ACCESS_KEY_ID=
STORAGE_MIRROR_SECRET_ACCESS_KEY=
STORAGE_MIRROR_BUCKET=
STORAGE_MIRROR_REGION=ap-guangzhou
STORAGE_MIRROR_REQUEST_TIMEOUT_SECONDS=5
ASSET_STORAGE_PREFIX=assets
# 私有 R2 边缘分发。Worker 路由建议使用同域 https://image.foxapi.cn/cdn-assets
ASSET_DELIVERY_BASE_URL=
# 与 Cloudflare Worker Secret ASSET_SIGNING_KEY 保持一致，必须长期固定
ASSET_DELIVERY_SIGNING_KEY=
ASSET_DELIVERY_URL_TTL_SECONDS=86400
ASSET_STORAGE_REQUEST_TIMEOUT_SECONDS=20
IMAGE_ASSET_MAX_PREVIEW_PX=1536
IMAGE_ASSET_THUMB_PX=320
# 0 keeps user web-history assets permanently; temporary/export retention is separate.
WEB_HISTORY_RETENTION_DAYS=0

# Public static assets (separate bucket, safe to expose)
# Store only installers, update metadata, pet sprites, and other public UI assets here.
PUBLIC_ASSET_BASE_URL=https://image.foxapi.cn/public-assets
DESKTOP_WINDOWS_URL=
DESKTOP_MAC_URL=
DESKTOP_VERSION=
DESKTOP_CHANGELOG=

# ─── 数据库容灾备份 ─────────────────────────────────────────
# 后台「系统设置 -> 数据备份」会保存定时策略和 S3/R2 目标配置。
# 未配置 S3/R2 时，备份文件写入 BACKUP_LOCAL_DIR。
BACKUP_LOCAL_DIR=backups
# 恢复数据库会覆盖当前数据，默认关闭；确认需要恢复能力后再打开。
BACKUP_RESTORE_ENABLED=false
# Gallery browsing can remain enabled while user submissions stay off.
PUBLIC_GALLERY_USER_SUBMISSIONS_ENABLED=false
